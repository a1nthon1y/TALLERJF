# Copia este archivo como .env y completa los valores
# cp .env.example .env

# Puerto donde corre el backend (debe coincidir con el de tu .env del frontend)
PORT=4000

NODE_ENV=development

# Base de datos PostgreSQL (Neon u otro provider)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Secreto para firmar JWT (mínimo 32 caracteres en producción)
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga

# Orígenes permitidos por CORS, separados por coma. Default permite todo (dev)
# Producción: CORS_ORIGINS=https://tudominio.com,https://www.tudominio.com
# CORS_ORIGINS=http://localhost:3000

# IMPORTANTE: el frontend (.env.local en JF-FRONT) debe usar la URL completa con /api:
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
